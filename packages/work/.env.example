# ========================================================================
# work 是单主的本机工作台：没有登录、没有跨域客户端，因此只需要数据库地址。
# 服务只监听 127.0.0.1，不要把端口暴露到局域网或公网。
# ========================================================================

# 数据库（必需）。缺失时 server/utils/db.ts 会静默回落到写死的 localhost 连接。
POSTGRES_URL=postgresql://root:root@localhost:5432/mw

# 监听地址。devServer 的 127.0.0.1 只管 `pnpm work:start`；
# 生产由 nitro 的 node preset 读取这两个变量，且它**不解析 `--host`/`--port` 命令行参数**，
# 不留空就会绑到 0.0.0.0 —— 对没有任何鉴权的 work 来说等于把整个工作台开放给局域网。
# 确认要对外监听（例如前面已有带鉴权的反代）时，除改这里还要设 WORK_ALLOW_PUBLIC_BIND=true。
NITRO_HOST=127.0.0.1
NITRO_PORT=3001

# DeepSeek 官方供应商的自动 seed 会读取此 Key（也可全部在「设置 → 模型供应商」里配置）
NUXT_DEEPSEEK_API_KEY=

# 可选：数据库内 API Key / 存储密钥的应用层加密主密钥（64 位 hex 或 base64 的 32 字节）。
# 未设置时保持明文（兼容旧库）；设置后新写入的密钥为 enc:v1: AES-256-GCM 密文。
# 换钥时把旧值放到 WORK_SECRET_KEY_OLD，重新保存一次各密钥即可完成轮换。
# WORK_SECRET_KEY=
# WORK_SECRET_KEY_OLD=

# 自动压缩：默认开启；设为 0 后只在界面手动点「压缩旧历史」时压缩。
# WORK_AUTO_COMPACT=0

# 限流与缓存的跨实例账本；未配置时自动降级为进程内存模式
REDIS_URL=

# 允许 HTTP 工具与 MCP 访问内网/回环地址（默认拒绝，防 SSRF；本地自建服务可临时开启）
ALLOW_PRIVATE_OUTBOUND=false

# 可选：允许智能体只读访问的本地目录，多个目录用英文分号分隔。
# 未配置时不会注入任何本地文件工具；配置后模型只能读取这些目录内的文本文件。
# WORK_FILE_ROOTS=D:\Workspace\notes;D:\Documents\work
# 允许写入上述目录（默认关闭）。写入仍受白名单限制，ask 模式下由审批卡确认。
# WORK_FILE_WRITE=1
# 允许 run_command/start_job（默认关闭）。命令仍是 shell 字符串，auto 模式也要求审批。
# WORK_COMMAND_ENABLED=1
# 允许 web_fetch 读取公开网页（默认关闭；会拒绝 localhost 与私网地址）。
# WEB_TOOL_ENABLED=1
# 可选：web_search 供应商。默认按下面的 key 自动选择；也可用 WEB_SEARCH_PROVIDER=tavily|brave 显式指定。
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# WEB_SEARCH_PROVIDER=
# 可选：知识库向量后端。默认 1536 维走 pgvector（需 0016 迁移成功），设 jsonb 强制旧余弦路径。
# WORK_VECTOR_BACKEND=pgvector
# 可选：技能目录，多个目录用系统路径分隔符（Windows 分号、POSIX 冒号）。
# 「设置 → 技能 → 从目录同步」会扫描其中的 SKILL.md / *.md，按路径哈希幂等 upsert。
# WORK_SKILL_ROOTS=D:\Workspace\skills;D:\Notes\skills
