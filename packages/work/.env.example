# ========================================================================
# work 是单主的本机工作台：没有登录、没有跨域客户端，因此只需要数据库地址。
# 服务只监听 127.0.0.1，不要把端口暴露到局域网或公网。
# ========================================================================

# 数据库（必需）。缺失时 server/utils/db.ts 会静默回落到写死的 localhost 连接。
POSTGRES_URL=postgresql://root:root@localhost:5432/mw

# 监听地址。devServer 的 127.0.0.1 只管 `pnpm work:start`；
# 生产由 nitro 的 node preset 读取这两个变量，且它**不解析 `--host`/`--port` 命令行参数**，
# 不留空就会绑到 0.0.0.0 —— 对没有任何鉴权的 work 来说等于把整个工作台开放给局域网。
# 确认要对外监听（例如前面已有带鉴权的反代）时，除改这里还要设 WORK_ALLOW_PUBLIC_BIND=true。
NITRO_HOST=127.0.0.1
NITRO_PORT=3001

# DeepSeek 官方供应商的自动 seed 会读取此 Key（也可全部在「设置 → 模型供应商」里配置）
NUXT_DEEPSEEK_API_KEY=

# 限流与缓存的跨实例账本；未配置时自动降级为进程内存模式
REDIS_URL=

# 允许 HTTP 工具与 MCP 访问内网/回环地址（默认拒绝，防 SSRF；本地自建服务可临时开启）
ALLOW_PRIVATE_OUTBOUND=false
