# ========================================================================
# Nuxt
# ========================================================================
# DeepSeek 官方供应商的自动 seed 会读取此 Key（也可全部在管理后台「模型供应商」里配置）
NUXT_DEEPSEEK_API_KEY=xxxxxxx
# ========================================================================
# Database
# ========================================================================
POSTGRES_URL=postgresql://root:root@localhost:5432/me
# ========================================================================
# Auth (better-auth)
# ========================================================================
# 会话签名密钥：请用 `openssl rand -base64 32` 生成后再填入。
# 留空或仍使用示例占位符时，服务在 production 下会拒绝启动（见 server/plugins/env-guard.ts）
BETTER_AUTH_SECRET=382724cdde705bd5d5b79e21ec13df2e80ba2f014c163864dbb461d49450f83e
# 服务对外地址（生产环境必须显式设置）
BETTER_AUTH_URL=http://localhost:3000
# ========================================================================
# 数据库迁移 (drizzle-kit)
# ========================================================================
# pnpm webapp:db:generate  生成迁移
# pnpm webapp:db:migrate   应用迁移
# ========================================================================
# Redis (用于分布式限流与缓存，未配置时自动降级为内存模式)
# ========================================================================
REDIS_URL=redis://:redis@127.0.0.1:6379/0
# ========================================================================
# 管理员初始口令与 CORS
# ========================================================================
# seed 首次创建管理员账号时使用的口令（仅初始化时生效，请改成自己的强口令）
ADMIN_INITIAL_PASSWORD=Admin@123
# 允许跨域访问的来源，逗号分隔；留空表示仅放行 BETTER_AUTH_URL 与本地开发地址
# 例：CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# 是否允许 HTTP 工具访问内网/回环地址（默认拒绝，防 SSRF；本地自建服务可临时开启）
ALLOW_PRIVATE_OUTBOUND=false
# ========================================================================
# 微信公众号网页授权登录
# ========================================================================
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URL={BETTER_AUTH_URL}/api/auth/wechat/callback
# ========================================================================
# 微信支付 (better-wechatpay)
# ========================================================================
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL={BETTER_AUTH_URL}/api/pay/notify/wechat
MOCK_PAY_ENABLED=false
# ========================================================================
# 移动端地址 (微信授权回跳支持)
# ========================================================================
MOBILE_APP_URL=http://localhost:5173/
