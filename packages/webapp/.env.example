# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# Database URL for PostgreSQL
DATABASE_URL="postgresql://root:root@localhost:5432/me"

# AI providers（至少配置一个，聊天接口才能工作）
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# https://platform.openai.com/
OPENAI_API_KEY=

# Seed 管理员初始口令（未设置时 db:seed 生成随机口令）
# ADMIN_INITIAL_PASSWORD=

# CORS 白名单（逗号分隔，默认含 Ionic/Vite/Capacitor 本地端口；小程序客户端上线后加入其请求来源）
# CORS_ORIGINS=

# ── 微信公众号（网页授权登录；不配置则隐藏微信登录入口）──
# WECHAT_OAUTH_APP_ID=
# WECHAT_OAUTH_APP_SECRET=
# WECHAT_OAUTH_REDIRECT_URL= # 可选，默认 {BETTER_AUTH_URL}/api/auth/wechat/callback

# ── 微信支付（better-wechatpay；不配置时订单走 mock 模拟渠道，便于本地联调）──
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=      # APIv3 密钥（32 位）
# WECHAT_PAY_PRIVATE_KEY=  # 商户私钥 PEM（\n 转义），或用下面的文件路径
# WECHAT_PAY_PRIVATE_KEY_PATH=
# WECHAT_PAY_PUBLIC_KEY=   # 微信支付公钥/平台证书 PEM
# WECHAT_PAY_NOTIFY_URL=   # 可选，默认 {BETTER_AUTH_URL}/api/pay/notify/wechat

# 移动端地址（微信登录回跳 mobile 时使用，如 http://192.168.1.5:8100）
# MOBILE_APP_URL=
