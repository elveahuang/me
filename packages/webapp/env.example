# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# Database URL for PostgreSQL
DATABASE_URL="postgresql://root:root@localhost:5432/me"

# AI providers（至少配置一个，聊天接口才能工作）
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# https://platform.openai.com/
OPENAI_API_KEY=
