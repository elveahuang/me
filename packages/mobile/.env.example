# ========================================================================
# 移动端构建 / 联调配置（Vite 只暴露 VITE_ 前缀变量）
# ========================================================================
# 打包原生 App 时的后端地址，例如 https://api.example.com
# 留空表示与页面同源（浏览器 dev/preview 走下面的代理）
VITE_API_BASE=

# 本地 dev / preview 时 /api 的代理目标（指向 webapp）
API_PROXY_TARGET=http://localhost:3000

# 可选：让原生 WebView 直接加载远端站点（真机联调 / 线上壳）
# CAPACITOR_SERVER_URL=https://app.example.com
