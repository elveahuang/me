# Compose 部署环境变量模板。
#
# 不要手工填写后提交：本文件用于说明有哪些变量，
# 实际部署请运行 `node deploy/init-env.mjs` 生成随机强密钥的 deploy/.env。
# 生产环境使用占位符会被 server/plugins/env-guard.ts 拒绝启动。

# ---------------- 必填：数据库 ----------------
POSTGRES_USER=ee
POSTGRES_PASSWORD=
POSTGRES_DB=ee

# ---------------- 必填：认证 ----------------
# 对外访问地址。必须与实际访问地址一致，否则登录态与微信回调会失效。
# 例：https://ee.example.com 或 http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# 会话签名密钥，务必随机生成（openssl rand -base64 32）
BETTER_AUTH_SECRET=
# 管理员账号初始口令（创建管理员时使用，见 deploy.md）
ADMIN_INITIAL_PASSWORD=

# ---------------- 必填：限流与缓存 ----------------
REDIS_PASSWORD=

# ---------------- 可选：服务端口 ----------------
APP_PORT=3000

# ---------------- 可选：对象存储（--profile storage 时生效） ----------------
RUSTFS_ACCESS_KEY=eeadmin
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=ee-uploads

# ---------------- 可选：模型供应商 ----------------
# 也可跳过，稍后在管理后台「模型供应商」中配置
NUXT_DEEPSEEK_API_KEY=

# ---------------- 可选：跨域与出站策略 ----------------
# 允许跨域访问的来源，逗号分隔；留空仅放行 BETTER_AUTH_URL
CORS_ORIGINS=
# 是否允许 HTTP 工具访问内网地址（默认拒绝，防 SSRF）
ALLOW_PRIVATE_OUTBOUND=false

# ---------------- 可选：微信登录与支付 ----------------
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
MOCK_PAY_ENABLED=false
